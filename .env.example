# PostgreSQL image bootstrap account for a NEW data directory only.
# This account is not used by Spring Boot or Flyway.
POSTGRES_DB=arena
POSTGRES_USER=arena_provisioner
POSTGRES_PASSWORD=replace-before-use

# One-time provisioning script inputs; use distinct strong values in local .env.
ARENA_DATABASE=arena
ARENA_PROVISION_NEW_DATABASE=NO
ARENA_RUNTIME_PASSWORD=replace-with-runtime-secret
ARENA_MIGRATOR_PASSWORD=replace-with-migrator-secret
ARENA_ADMIN_WRITER_PASSWORD=replace-with-admin-writer-secret
ARENA_OFFLINE_OPERATOR_PASSWORD=replace-with-offline-operator-secret

# Spring Boot running on the host. Runtime and Flyway credentials are distinct.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/arena
SPRING_DATASOURCE_USERNAME=arena_runtime
SPRING_DATASOURCE_PASSWORD=replace-with-runtime-secret
SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5432/arena
SPRING_FLYWAY_USER=arena_migrator
SPRING_FLYWAY_PASSWORD=replace-with-migrator-secret

# The application JWT secret is independent of PostgreSQL credentials.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
